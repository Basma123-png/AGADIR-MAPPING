# ==============================================================================
# AGADIR MAPPING — Configuration de l'environnement
# ==============================================================================

# Clé API Google Gemini (utilisée pour l'agent raisonneur-arbitre)
GEMINI_API_KEY=your_gemini_api_key_here

# Modèle Gemini recommandé
GEMINI_MODEL=gemini-2.5-flash

# Serveur OSRM pour le routage routier (par défaut serveur public OpenStreetMap OSRM)
OSRM_BASE_URL=https://router.project-osrm.org

# Overpass API endpoint principal
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# Clé Semantic Scholar (optionnelle, pour augmenter les quotas de requêtes)
SEMANTIC_SCHOLAR_API_KEY=
